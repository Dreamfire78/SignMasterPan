; SignMasterPan language file: English (also used as fallback for missing texts)
; Format: UTF-8, key=value. "\n" inserts a line break, %1..%4 are placeholders.

[Language]
Code=en
Name=English

[Strings]
tray_active=Enabled
tray_settings=Settings...
tray_help=Help
tray_exit=Exit
tooltip=SignMaster Pan
tooltip_off=SignMaster Pan (disabled)
start=Running. Drag with the middle mouse button to pan the workspace.
active_on=Enabled: the functions are switched on again.
active_off=Disabled: middle mouse button and mouse wheel work normally again.
lang_auto=Automatic (Windows language)
hk_busy=The hotkey %1 is already in use by another program.\nPlease choose a different shortcut (tray menu → Settings).
hook_fail=Could not install the mouse hook.
key_ctrl=Ctrl
help=Hold and drag the middle mouse button = pan the workspace.\nThe active tool stays selected. Esc cancels a running pan.\n\nMouse wheel over the workspace = %2 (up) / %3 (down).\nWith Ctrl/Shift/Alt/Win held, the mouse wheel works as usual.\n\nTray menu → Enabled or %1 temporarily switches all functions off and on again.\nWhich functions are used is defined in the settings.\n\nSettings are saved automatically in %4.

